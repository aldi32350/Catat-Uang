# Salin file ini menjadi ".env" lalu isi nilainya.

# Kunci API Anthropic untuk fitur baca foto struk (buat di https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Nomor lain yang boleh mencatat lewat chat ke nomor bot, pisahkan dengan koma (awali 62)
NOMOR_DIIZINKAN=

